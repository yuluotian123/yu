[gd_resource type="Resource" script_class="DialogueGraphAsset" format=3]

[ext_resource type="Script" path="res://scripts/gamelogic/dialogue/DialogueGraphAsset.cs" id="1"]

[resource]
script = ExtResource("1")
Title = "林间来信"
CharactersPerSecond = 32.0
GraphJson = "{\"$type\":\"yu:GraphDocument\",\"SchemaVersion\":2,\"GraphType\":\"Dialogue\",\"ActionDependencyMode\":\"HostBound\",\"HasActionDependencyMode\":true,\"Nodes\":[{\"$type\":\"yu:GameLogic.DialogueStartNodeData\",\"Id\":\"start\",\"NodeType\":\"DialogueStartNodeData\",\"Position\":{\"x\":0,\"y\":180}},{\"$type\":\"yu:GameLogic.DialogueBranchNodeData\",\"Id\":\"met_before\",\"NodeType\":\"DialogueBranchNodeData\",\"Position\":{\"x\":280,\"y\":180},\"MemoryKey\":\"introduced\"},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"narration\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":560,\"y\":0},\"Speaker\":\"\",\"NewPage\":true,\"Text\":\"风从树梢落下来，带着一点潮湿的木叶气息。\\n街角的人收起手里的信，抬头看向你。\"},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"greeting\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":860,\"y\":0},\"Speaker\":\"{npc}\",\"Text\":\"第一次来这里吗？天黑以后，林子里的路可不太好认。\"},{\"$type\":\"yu:GameLogic.DialogueSetFlagNodeData\",\"Id\":\"introduce\",\"NodeType\":\"DialogueSetFlagNodeData\",\"Position\":{\"x\":1160,\"y\":0},\"Value\":true,\"MemoryKey\":\"introduced\"},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"return\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":560,\"y\":370},\"Speaker\":\"{npc}\",\"NewPage\":true,\"Text\":\"又见面了，{player}。上次说的那条小路，你找到了吗？\"},{\"$type\":\"yu:GameLogic.DialogueChoiceNodeData\",\"Id\":\"question\",\"NodeType\":\"DialogueChoiceNodeData\",\"Position\":{\"x\":1460,\"y\":180},\"Prompt\":\"你想说些什么？\",\"Options\":[{\"$type\":\"yu:GameLogic.DialogueOption\",\"Text\":\"问问这里是什么地方\",\"RequiredValue\":true,\"RequiredMemory\":\"\"},{\"$type\":\"yu:GameLogic.DialogueOption\",\"Text\":\"问问森林里的小路\",\"RequiredValue\":true,\"RequiredMemory\":\"\"},{\"$type\":\"yu:GameLogic.DialogueOption\",\"Text\":\"先告辞\",\"RequiredValue\":true,\"RequiredMemory\":\"\"}]},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"town\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":1780,\"y\":0},\"Speaker\":\"{npc}\",\"NewPage\":true,\"Text\":\"这里是林间镇。沿着石板路一直走，就能看到广场。\\n要是累了，可以去树下坐一会儿。\"},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"path\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":1780,\"y\":280},\"Speaker\":\"{npc}\",\"NewPage\":true,\"Text\":\"从广场向东，经过那口井，再沿着有灯的小径走。\\n如果听见风铃，就说明你没有走错。\"},{\"$type\":\"yu:GameLogic.DialogueSetFlagNodeData\",\"Id\":\"learn_path\",\"NodeType\":\"DialogueSetFlagNodeData\",\"Position\":{\"x\":2100,\"y\":280},\"Value\":true,\"MemoryKey\":\"knows_path\"},{\"$type\":\"yu:GameLogic.DialogueLineNodeData\",\"Id\":\"goodbye\",\"NodeType\":\"DialogueLineNodeData\",\"Position\":{\"x\":2420,\"y\":180},\"Speaker\":\"{npc}\",\"NewPage\":false,\"Text\":\"路上小心。我们还会再见的。\"},{\"$type\":\"yu:GameLogic.DialogueEndNodeData\",\"Id\":\"end\",\"NodeType\":\"DialogueEndNodeData\",\"Position\":{\"x\":2740,\"y\":180},\"Result\":\"Completed\"}],\"Connections\":[{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"start\",\"FromPort\":0,\"ToNode\":\"met_before\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"met_before\",\"FromPort\":0,\"ToNode\":\"return\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"met_before\",\"FromPort\":1,\"ToNode\":\"narration\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"narration\",\"FromPort\":0,\"ToNode\":\"greeting\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"greeting\",\"FromPort\":0,\"ToNode\":\"introduce\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"introduce\",\"FromPort\":0,\"ToNode\":\"question\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"return\",\"FromPort\":0,\"ToNode\":\"question\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"question\",\"FromPort\":0,\"ToNode\":\"town\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"question\",\"FromPort\":1,\"ToNode\":\"path\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"question\",\"FromPort\":2,\"ToNode\":\"goodbye\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"town\",\"FromPort\":0,\"ToNode\":\"goodbye\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"path\",\"FromPort\":0,\"ToNode\":\"learn_path\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"learn_path\",\"FromPort\":0,\"ToNode\":\"goodbye\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GraphConnection\",\"FromNode\":\"goodbye\",\"FromPort\":0,\"ToNode\":\"end\",\"ToPort\":0,\"IsAvailable\":true}],\"BlackboardEntries\":[],\"EditorState\":{\"$type\":\"yu:GraphEditorState\",\"ScrollOffset\":{\"x\":-80,\"y\":-160},\"Zoom\":0.7}}"
