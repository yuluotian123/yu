GraphJson = "{\"$type\":\"yu:GraphDocument\",\"SchemaVersion\":2,\"GraphType\":\"HfsmGraph\",\"ActionDependencyMode\":\"HostBound\",\"HasActionDependencyMode\":true,\"Nodes\":[{\"$type\":\"yu:GameLogic.HfsmAnimationStateNodeData\",\"AnimationName\":\"idle\",\"RequestKey\":\"hfsm:locomotion\",\"AnimationPriority\":0,\"Speed\":1,\"FromEnd\":false,\"RestartIfPlaying\":false,\"BehaviourKey\":\"\",\"MetadataJson\":\"{}\",\"StateName\":\"Idle\",\"IsDefault\":true,\"Id\":\"state_idle\",\"Position\":{\"x\":60,\"y\":1120},\"NodeType\":\"HfsmAnimationStateNodeData\"},{\"$type\":\"yu:GameLogic.HfsmAnimationStateNodeData\",\"AnimationName\":\"walk\",\"RequestKey\":\"hfsm:locomotion\",\"AnimationPriority\":0,\"Speed\":1,\"FromEnd\":false,\"RestartIfPlaying\":false,\"BehaviourKey\":\"\",\"MetadataJson\":\"{}\",\"StateName\":\"Walk\",\"IsDefault\":false,\"Id\":\"state_run\",\"Position\":{\"x\":-20,\"y\":900},\"NodeType\":\"HfsmAnimationStateNodeData\"}],\"Connections\":[{\"$type\":\"yu:GameLogic.HfsmTransitionConnection\",\"TransitionName\":\"Move\",\"Priority\":10,\"CompletionOnly\":false,\"UseMode\":\"Or\",\"Conditions\":[{\"$type\":\"yu:GameLogic.HfsmFloatCondition\",\"Comparison\":\"Greater\",\"Value\":0.01,\"Tolerance\":0.0001,\"Description\":\"Character.Movement.MoveAmount > 0.01\",\"Parameter\":{\"$type\":\"yu:GraphBlackboardKeyReference\",\"Key\":\"Character.Movement.MoveAmount\",\"ValueTypeName\":\"System.Single\"},\"ParameterName\":\"Character.Movement.MoveAmount\"}],\"FromNode\":\"state_idle\",\"FromPort\":0,\"ToNode\":\"state_run\",\"ToPort\":0,\"IsAvailable\":true},{\"$type\":\"yu:GameLogic.HfsmTransitionConnection\",\"TransitionName\":\"Stop\",\"Priority\":10,\"CompletionOnly\":false,\"UseMode\":\"And\",\"Conditions\":[{\"$type\":\"yu:GameLogic.HfsmFloatCondition\",\"Comparison\":\"LessOrEqual\",\"Value\":0.01,\"Tolerance\":0.0001,\"Description\":\"Character.Movement.MoveAmount <= 0.01\",\"Parameter\":{\"$type\":\"yu:GraphBlackboardKeyReference\",\"Key\":\"Character.