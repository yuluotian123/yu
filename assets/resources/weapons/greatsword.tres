[resource]
script = ExtResource("1_script")
WeaponId = "greatsword"
DisplayName = "大剑"
PrimaryAttack = ExtResource("2_attack")
StancePrimaryAttacks = Dictionary[String, ExtResource("6_a5kyl")]({
"high": ExtResource("6_high_attack"),
"low": ExtResource("7_low_attack"),
"mid": ExtResource("2_attack")
})
AnimationProfile = ExtResource("3_animation")
StanceIdleAnimations = Dictionary[String, String]({
"high": "idle_high",
"low": "idle_low",
"mid": "idle_mid"
})
StanceMoveAnimations = Dictionary[String, String]({
"high": "run_high",
"low": "run_low",
"mid": "run_mid"
})
StanceMoveStartAnimations = Dictionary[String, String]({
"high": "run_start_high",
"mid": "run_start_mid"
})
StanceTransitions = Dictionary[String, String]({
"high>low": "stance_high_to_low",
"high>mid": "stance_high_to_mid",
"low>high": "stance_low_to_high",
"low>mid": "stance_low_to_mid",
"mid>high": "stance_mid_to_high",
"mid>low": "stance_mid_to_low"
})
StanceEffectGraph = ExtResource("stance_effect_graph")
Icon = ExtResource("4_icon")
Portrait = ExtResource("5_portrait")
Description = "宽厚的剑刃带来沉稳的挥砍。适合把握时机、正面迎击。"
