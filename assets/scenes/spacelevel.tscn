[node name="CameraRig" type="Node3D" parent="." unique_id=1603033638]
process_priority = 100
physics_interpolation_mode = 2
editor_description = "场景镜头控制器。展开 Components > SceneCameraComponent3D > Profile 调整跟随参数。X/Y/Z 对应世界左右/上下/前后，距离单位为米。DeadZone 越大越允许角色自由移动；FollowSmooth 越大跟随越快，0 表示直接到位。距离、俯角、FOV 请在子节点 Camera3D 调整。详见 res://assets/camera/HD2D.md。"
script = ExtResource("5_host")
Components = Array[ExtResource("6_component")]([SubResource("camera_controller")])

[node name="Camera3D" type="Camera3D" parent="CameraRig" unique_id=106388751]
editor_description = "偏横版近景镜头：透视 FOV=30°，Rotation Degrees.X=-4.1°（轻微俯视），拍摄距离约 9 米。人物位于屏幕中心下方，天空和云保留在上半部。
Transform/Position：沿镜头局部 Z 轴向负方向移动可拉近，向正方向移动可拉远；这是实际拍摄距离。Rotation Degrees.X 越接近 0 越平视，越负越俯视。
FOV：仅透视生效，越小人物越大、视野越窄；越大视野越广。默认 Keep Aspect=Keep Height 时表示竖直视角。
Size=7：仅正交/视锥投影生效，越小人物越大；不影响透视。Far=500：最远可见距离（米），减小可能裁掉远处天空或云。
构图位置为 (1.6, -7.15, 8.8033)，视线高于角色中心，人物约在画面高度的三分之二处。保持角度和 Z 距离时，提高 Position.Y 会让人物更靠下，降低则让人物上移。运行时保留场景镜头角度和相对偏移，随角色平移；请在停止游戏时编辑。跟随死区、平滑及前视在 CameraRig 的 Profile 中调整。"
transform = Transform3D(1, 0, 0, 0, 0.99744076, 0.07149744, 0, -0.07149744, 0.99744076, 1.6, -7.15, 8.8033285)
current = true
fov = 30.0
size = 7.0
far = 500.0

