[gd_scene load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="track"]
bg_color = Color(0.12, 0.17, 0.23, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_left = 5
corner_radius_bottom_right = 5

[sub_resource type="StyleBoxFlat" id="fill"]
bg_color = Color(0.55, 0.79, 0.85, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_left = 5
corner_radius_bottom_right = 5

[node name="LevelLoadingWindow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.05, 0.075, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 64

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 20

[node name="Heading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.79, 0.85, 1)
theme_override_font_sizes/font_size = 20
text = "正在前往"

[node name="Space" type="Control" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Margin/Layout"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="LevelName" type="Label" parent="Margin/Layout/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.96, 0.98, 1)
theme_override_font_sizes/font_size = 38
text = "目的地"
autowrap_mode = 3

[node name="ProgressRow" type="HBoxContainer" parent="Margin/Layout/Content"]
layout_mode = 2
mouse_filter = 2

[node name="Stage" type="Label" parent="Margin/Layout/Content/ProgressRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.64, 0.7, 0.77, 1)
theme_override_font_sizes/font_size = 18
text = "正在准备"

[node name="Percentage" type="Label" parent="Margin/Layout/Content/ProgressRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.79, 0.85, 1)
theme_override_font_sizes/font_size = 18
text = "0%"
horizontal_alignment = 2

[node name="Progress" type="ProgressBar" parent="Margin/Layout/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("track")
theme_override_styles/fill = SubResource("fill")
step = 0.01
show_percentage = false

[node name="Hint" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.44, 0.51, 0.59, 1)
theme_override_font_sizes/font_size = 16
text = "加载完成后将自动进入"
