[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/gamelogic/gameobject/GameObject3D.cs" id="1_host"]
[ext_resource type="Script" path="res://scripts/gamelogic/gameobject/Component3D.cs" id="2_base"]
[ext_resource type="Script" path="res://scripts/gamelogic/timeofday/TimeOfDayGmComponent3D.cs" id="3_gm"]

[sub_resource type="Resource" id="gm"]
script = ExtResource("3_gm")

[sub_resource type="InputEventKey" id="toggle_key"]
keycode = 4194339

[sub_resource type="Shortcut" id="shortcut"]
events = [SubResource("toggle_key")]

[sub_resource type="StyleBoxFlat" id="panel_style"]
content_margin_left = 20.0
content_margin_top = 16.0
content_margin_right = 20.0
content_margin_bottom = 16.0
bg_color = Color(0.035, 0.055, 0.095, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.21, 0.36, 0.47, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[node name="TimeGm" type="Node3D"]
process_mode = 3
script = ExtResource("1_host")
Components = Array[ExtResource("2_base")]([SubResource("gm")])

[node name="CanvasLayer" type="CanvasLayer" parent="."]
layer = 100

[node name="Root" type="Control" parent="CanvasLayer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 17

[node name="Toggle" type="Button" parent="CanvasLayer/Root"]
unique_name_in_owner = true
layout_mode = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -176.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 52.0
grow_horizontal = 0
focus_mode = 0
text = "时间 GM · F8"
toggle_mode = true
shortcut = SubResource("shortcut")

[node name="Panel" type="PanelContainer" parent="CanvasLayer/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -396.0
offset_top = 64.0
offset_right = -16.0
grow_horizontal = 0
theme_override_styles/panel = SubResource("panel_style")

[node name="Content" type="VBoxContainer" parent="CanvasLayer/Root/Panel"]
