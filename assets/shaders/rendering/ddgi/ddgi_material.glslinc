// Controlled hit-material protocol. Direct-light stylization and specular lobes
// stay in raster shaders; GI uses the resulting diffuse color and emission.
struct Triangle {
	vec4 a; vec4 b; vec4 c; vec4 uv01; vec4 uv2;
	vec4 na; vec4 nb; vec4 nc; vec4 ca; vec4 cb; vec4 cc;
};
struct Material {
	vec4 albedo; vec4 emission_metallic; vec4 uv_transform; vec4 options;
	vec4 average_saturation; vec4 detail_vertex_kind_orm;
	vec4 weather; vec4 puddles; vec4 snow_color; vec4 foliage; vec4 lower; vec4 upper;
};

vec3 gi_crown_center(vec3 position) {
	const vec3 centers[6] = vec3[6](vec3(-4.9, 3.57, 5.0), vec3(5.5, 3.88, -1.5),
		vec3(2.0, 3.27, 12.3), vec3(8.5, 3.95, -13.5), vec3(-8.5, 4.10, -14.0), vec3(-17.0, 4.18, -10.8));
	vec3 center = centers[0];
	float nearest = 1e20;
	for (int i = 0; i < 6; i++) {
		float d = dot(position - centers[i], position - centers[i]);
		if (d < nearest) { nearest = d; center = centers[i]; }
	}
	return center;
}

vec3 gi_palette(vec3 color) {
	float brightness = sqrt(max(color.r, max(color.g, color.b)));
	vec3 painted = mix(vec3(.028, .12, .073), vec3(.11, .29, .058), smoothstep(.18, .55, brightness));
	return mix(painted, vec3(.27, .48, .17), smoothstep(.55, .89, brightness));
}

float gi_snow(vec3 position, vec3 normal, float amount) {
	float noise = snow_pattern(position.xz);
	return smoothstep(1.0 - amount - .09, 1.0 - amount + .09, noise)
		* smoothstep(.45, .85, normal.y) * smoothstep(0.0, .12, amount);
}

vec2 gi_wet(vec3 position, vec3 normal, Material material) {
	float up = clamp(normal.y, 0.0, 1.0);
	float wet = material.weather.x * mix(.55, 1.0, up);
	float puddle = 0.0;
	if (material.puddles.x > .5 && material.weather.y > 0.0) {
		float noise = puddle_pattern(position.xz * max(material.puddles.z, .01));
		float threshold = 1.0 - material.puddles.y * material.weather.y;
		puddle = smoothstep(threshold - .06, threshold + .06, noise)
			* smoothstep(.02, .15, material.weather.y) * smoothstep(.88, .98, up) * step(.0001, material.puddles.y);
	}
	return vec2(wet, puddle);
}
