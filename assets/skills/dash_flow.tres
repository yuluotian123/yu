GraphJson = "{\"$type\":\"GraphDocument\",\"SchemaVersion\":2,\"GraphType\":\"SkillFlowGraph\",\"Nodes\":[{\"$type\":\"FlowEntryNodeData\",\"Id\":\"dash_entry\",\"Position\":{\"x\":0,\"y\":0},\"NodeType\":\"FlowEntryNodeData\"},{\"$type\":\"FlowTimelineNodeData\",\"Duration\":0.16,\"Tracks\":[{\"$type\":\"FlowTimelineTrack\",\"Name\":\"Movement\",\"Enabled\":true,\"Clips\":[{\"$type\":\"FlowTimelineClip\",\"Id\":\"dash_velocity\",\"Name\":\"Dash Velocity\",\"StartTime\":0,\"Duration\":0.16,\"Enabled\":true,\"Action\":{\"$type\":\"SkillApplyDashVelocityAction\",\"DirectionBlackboardKey\":\"Skill.DashDirection\",\"Speed\":760,\"StopVerticalVelocity\":true,\"Description\":\"Apply Dash Velocity\"}}]}],\"Markers\":[{\"$type\":\"FlowTimelineMarker\",\"Label\":\"Start\",\"Time\":0,\"Enabled\":true,\"Actions\":[{\"$type\":\"SkillResolveDashDirectionAction\",\"DirectionBlackboardKey\":\"Skill.DashDirection\",\"MoveAxisBlackboardKey\":\"MoveAxisX\",\"Description\":\"Resolve Dash Direction\"},{\"$type\":\"SkillSetVisualModulateAction\",\"VisualRootPath\":\"VisualRoot\",\"Enabled\":true,\"ActiveColor\":{\"r\":0.55,\"g\":0.95,\"b\":1,\"a\":1},\"Description\":\"Set Skill Visual\"}]},{\"$type\":\"FlowTimelineMarker\",\"Label\":\"Complete\",\"Time\":0.16,\"Enabled\":true,\"Actions\":[{\"$type\":\"SkillSetVisualModulateAction\",\"VisualRootPath\":\"VisualRoot\",\"Enabled\":false,\"ActiveColor\":{\"r\":0.55,\"g\":0.95,\"b\":1,\"a\":1},\"Description\":\"Restore Skill Visual\"}]}],\"CancelActions\":[{\"$type\":\"SkillSetVisualModulateAction\",\"VisualRootPath\":\"VisualRoot\",\"Enabled\":false,\"ActiveColor\":{\"r\":0.55,\"g\":0.95,\"b\":1,\"a\":1},\"Description\":\"Restore Skill Visual\"}],\"Id\":\"dash_timeline\",\"Position\":{\"x\":320,\"y\":0},\"NodeType\":\"FlowTimelineNodeData\"},{\"$type\":\"FlowReturnNodeData\",\"Label\":\"Finished\",\"Id\":\"dash_return\",\"Position\":{\"x\":680,\"y\":0},\"NodeType\":\"FlowReturnNodeData\"}],\"Connections\":[{\"$type\":\"GraphConnection\",\"Fr