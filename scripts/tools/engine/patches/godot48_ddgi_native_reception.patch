+void RenderSceneBuffersRD::set_ddgi(RID p_irradiance, RID p_distance, RID p_state, const Vector3 &p_origin, float p_spacing, const Vector3i &p_counts, float p_energy, float p_normal_bias, float p_view_bias) {
+	RD *rd = RD::get_singleton();
+	ERR_FAIL_COND(!p_origin.is_finite() || !Math::is_finite(p_spacing) || p_spacing <= 0.0f);
+	ERR_FAIL_COND(p_counts.x < 2 || p_counts.y < 2 || p_counts.z < 2 || p_counts.x > 32 || p_counts.y > 16 || p_counts.z > 32);
+	ERR_FAIL_COND(!Math::is_finite(p_energy) || p_energy < 0.0f || !Math::is_finite(p_normal_bias) || p_normal_bias < 0.0f || !Math::is_finite(p_view_bias) || p_view_bias < 0.0f);
+	const RID textures[] = { p_irradiance, p_distance, p_state };
+	const uint32_t tile_sizes[] = { 10, 18, 1 };
+	const RD::DataFormat formats[] = { RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R32G32_SFLOAT, RD::DATA_FORMAT_R32G32B32A32_SFLOAT };
+	for (uint32_t i = 0; i < 3; i++) {
+		ERR_FAIL_COND(!rd->texture_is_valid(textures[i]));
+		RD::TextureFormat format = rd->texture_get_format(textures[i]);
+		ERR_FAIL_COND(format.texture_type != RD::TEXTURE_TYPE_2D || format.array_layers != 1 || format.format != formats[i]);
+		ERR_FAIL_COND(format.width != uint32_t(p_counts.x * p_counts.z) * tile_sizes[i] || format.height != uint32_t(p_counts.y) * tile_sizes[i]);
+		ERR_FAIL_COND(!(format.usage_bits & RD::TEXTURE_USAGE_SAMPLING_BIT));
+	}
+	DDGIUniformData data;
+	static_assert(sizeof(data) == 48);
+	data.origin_spacing[0] = p_origin.x;
+	data.origin_spacing[1] = p_origin.y;
+	data.origin_spacing[2] = p_origin.z;
+	data.origin_spacing[3] = p_spacing;
+	data.counts_enabled[0] = p_counts.x;
+	data.counts_enabled[1] = p_counts.y;
+	data.counts_enabled[2] = p_counts.z;
+	data.counts_enabled[3] = 1;
+	data.energy_bias[0] = p_energy;
+	data.energy_bias[1] = p_normal_bias;
+	data.energy_bias[2] = p_view_bias;
+	if (ddgi_uniform_buffer.is_null()) {
+		ddgi_uniform_buffer = rd->uniform_buffer_create(sizeof(data), { reinterpret_cast<const uint8_t *>(&data), sizeof(data) });
+	} else {
+		rd->buffer_update(ddgi_uniform_buffer, 0, sizeof(data), &data);
+	}
+	ddgi_irradiance = p_irradiance;
+	ddgi_distance = p_distance;
+	ddgi_state = p_state;
+	ddgi_frame = rd->get_frames_drawn();
+}
+
+void RenderSceneBuffersRD::clear_ddgi() {
+	ddgi_irradiance = RID();
+	ddgi_distance = RID();
+	ddgi_state = RID();
+	ddgi_frame = UINT64_MAX;
+}
+
+bool RenderSceneBuffersRD::has_ddgi() const {
+	RD *rd = RD::get_singleton();
+	return ddgi_frame == rd->get_frames_drawn() && ddgi_uniform_buffer.is_valid() && rd->texture_is_valid(ddgi_irradiance) && rd->texture_is_valid(ddgi_distance) && rd->texture_is_valid(ddgi_state);
+}
